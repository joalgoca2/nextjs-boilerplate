generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- AUTHENTICATION & USERS ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  isActive      Boolean   @default(true)
  bio           String?   @db.Text
  locale        String    @default("es")
  timezone      String    @default("UTC")

  showWalkthrough     Boolean   @default(true)
  walkthroughStep     Int       @default(0)
  walkthroughDoneAt   DateTime?
  securityPin         String?
  webauthnCredential  String?   @db.Text

  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  accounts      Account[]
  sessions      Session[]
  roles         UserRole[]
  loginHistory  LoginHistory[]
  notifications Notification[]
  subscriptions Subscription[]
  payments      Payment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

// --- NEXTAUTH MODELS ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- ROLE-BASED ACCESS CONTROL (RBAC) ---

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("users_roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("roles_permissions")
}

// --- AUDIT & SECURITY ---

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?  @db.Text
  device    String?
  browser   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_history")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  points    Int      @default(0)
  expireAt  DateTime @map("expire_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rate_limits")
}

// --- MULTITENANCY / BRAND ---

model Brand {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String?  @db.Text
  logoUrl            String?  @db.Text
  defaultLocale      String   @default("es")
  timezone           String   @default("UTC")

  apiKey             String?  @unique
  billingWebhookUrl  String?  @db.Text
  generalWebhookUrl  String?  @db.Text
  isWebhookEnabled   Boolean  @default(true)

  users              User[]
  webhookLogs        WebhookLog[]
  paymentConfig      BrandPaymentConfig?
  paymentTransactions PaymentTransaction[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("brands")
}

// --- SAAS SUBSCRIPTIONS & BILLING ---

model Subscription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  planName      String   @default("Free")
  status        String   @default("ACTIVE")
  billingCycle  String   @default("MONTHLY")

  startDate     DateTime @default(now())
  endDate       DateTime

  price         Float
  discount      Float    @default(0)
  finalPrice    Float

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount             Float
  discountApplied    Float    @default(0)
  paymentDate        DateTime @default(now())
  status             String   @default("SUCCESS")

  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  notes              String?  @db.Text

  @@index([userId])
  @@map("payments")
}

model PlanConfig {
  id                      String   @id @default(cuid())
  planName                String   @unique
  priceMonthly            Float    @default(0)
  priceYearly             Float    @default(0)
  currency                String   @default("USD")

  maxProjects             Int      @default(3)
  allowCSVImportExport    Boolean  @default(false)
  hasLiveSupport          Boolean  @default(false)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("plan_configs")
}

// --- NOTIFICATIONS ---

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  desc      String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// --- WEBHOOK LOGS & AUDITING ---

model WebhookLog {
  id            String    @id @default(cuid())
  brandId       String?   @map("brand_id")
  brand         Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  event         String
  url           String
  status        Int?
  success       Boolean   @default(false)
  payload       String    @db.Text
  response      String?   @db.Text
  errorMessage  String?   @map("error_message") @db.Text
  durationMs    Int?      @map("duration_ms")
  attempts      Int       @default(1)
  nextAttemptAt DateTime? @map("next_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([brandId])
  @@index([createdAt])
  @@index([nextAttemptAt])
  @@map("webhook_logs")
}

// --- CURRENCIES & EXCHANGE RATES ---

model ExchangeRate {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  symbol          String   @default("$")
  rateAgainstUsd  Float    @default(1.0)
  isDefault       Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("exchange_rates")
}

// --- PAYMENT ENGINE & BRAND GATEWAYS ---

enum PaymentGatewayType {
  CLIP
  STRIPE
  MERCADOPAGO
  PSE
  MOCK
}

model BrandPaymentConfig {
  id                 String             @id @default(cuid())
  brandId            String             @unique @map("brand_id")
  brand              Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  gatewayType        PaymentGatewayType @default(CLIP) @map("gateway_type")
  publicKey          String             @map("public_key")
  encryptedSecretKey String             @map("encrypted_secret_key") @db.Text
  webhookSecret      String?            @map("webhook_secret")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("brand_payment_configs")
}

model PaymentTransaction {
  id             String             @id @default(cuid())
  ownerType      String             @default("BRAND") @map("owner_type")
  ownerId        String             @map("owner_id")
  brandId        String?            @map("brand_id")
  brand          Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  gatewayType    PaymentGatewayType @map("gateway_type")
  externalId     String             @map("external_id")
  checkoutUrl    String?            @map("checkout_url") @db.Text
  amount         Float
  currency       String             @default("MXN")
  status         String             @default("PENDING")
  metadata       String?            @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([ownerType, ownerId])
  @@index([externalId])
  @@index([brandId])
  @@map("payment_transactions")
}



